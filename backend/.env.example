# Backend
PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/afya_shop

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Admin default credentials (created by seed)
ADMIN_EMAIL=admin@afyaplus.co.tz
ADMIN_PASSWORD=Admin123!

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=afya-verify-token

# Selcom Payments
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_BASE_URL=https://apicore.selcommobile.com

# Flutterwave
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# DPO (Direct Pay Online)
DPO_TOKEN=
DPO_BASE_URL=https://secure.3gdirectpay.com

# SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+1xxxx
