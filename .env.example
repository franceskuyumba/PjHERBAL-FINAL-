# =============================================================
# PJHERBAL Clinic - environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to git.
# =============================================================

# --- Database -------------------------------------------------
# Local development (SQLite) - works out of the box:
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pjherbal?schema=public"

# --- Authentication --------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# --- Site ------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="PJHERBAL Clinic"

# --- Google Maps & social links --------------------------------
# Google Business Profile listing URL (set after profile verification)
NEXT_PUBLIC_GOOGLE_MAPS_URL=""
# Embed map link: Google Maps -> search your location -> Share -> Embed a map
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL="https://www.google.com/maps?q=Segerea,Dar+es+Salaam,Tanzania&output=embed"
NEXT_PUBLIC_FACEBOOK_URL="https://facebook.com/pjherbal"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/pjherbal"
NEXT_PUBLIC_TIKTOK_URL="https://tiktok.com/@pjherbal"
NEXT_PUBLIC_X_URL="https://x.com/pjherbal"

# --- WhatsApp --------------------------------------------------
# International format, digits only (e.g. 2557XXXXXXXX for Tanzania)
NEXT_PUBLIC_WHATSAPP_NUMBER="2557XXXXXXXX"
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Hello PJHERBAL Clinic, I would like some assistance."

# --- Payments --------------------------------------------------
# Select the active payment provider.
# "manual" = order confirmed via WhatsApp (no gateway credentials needed).
# "selcom" | "flutterwave" | "dpo" = live gateway.
PAYMENT_PROVIDER="manual"

# Selcom
SELCOM_API_KEY=""
SELCOM_API_SECRET=""
SELCOM_MERCHANT_ID=""
SELCOM_BASE_URL="https://apigw.selcommobile.com"

# Flutterwave
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
FLUTTERWAVE_BASE_URL="https://api.flutterwave.com/v3"

# DPO Pay
DPO_SERVICE_TYPE=""
DPO_COMPANY_TOKEN=""
DPO_BASE_URL="https://secure.3gdirectpay.com/API/v6/"

# --- Shipping --------------------------------------------------
SHIPPING_FEE_TZS="7000"
FREE_SHIPPING_THRESHOLD_TZS="200000"

# --- Analytics (optional; set to "true" to enable) -------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
