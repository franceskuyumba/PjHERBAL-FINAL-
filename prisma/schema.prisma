generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  orders    Order[]
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  imageUrl String?
  products Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  rating      String?     @default("4.8")
  categoryId  String?
  category    Category?   @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  items     OrderItem[]
  payments  Payment[]
  createdAt DateTime    @default(now())
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  amount    Float
  status    String
}

model BlogPost {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
}

model Coupon {
  id     String @id @default(cuid())
  code   String @unique
  amount Float
}

model Notification {
  id      String  @id @default(cuid())
  message String
}

model PaymentLog {
  id        String   @id @default(cuid())
  log       String
  createdAt DateTime @default(now())
}

model ProductView {
  id        String   @id @default(cuid())
  productId String
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  createdAt DateTime @default(now())
}

model SiteAsset {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  updatedAt DateTime @updatedAt
}