// PJHERBAL Clinic - database schema
// PostgreSQL is used for the local production-like environment.
// NOTE: SQLite does not support Prisma enums, so statuses are stored as strings
// and validated in the application layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  phone        String?
  passwordHash String
  role         String        @default("CUSTOMER") // CUSTOMER | ADMIN
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlist     WishlistItem[]
  notifications Notification[]
  productViews  ProductView[]
  passwordResetTokens PasswordResetToken[]

  @@index([role, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// An admin account is created only after an existing admin approves the request.
model AdminApprovalRequest {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String?
  passwordHash String
  status       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  requestedBy  String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([status, createdAt])
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model Address {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label       String  @default("Home")
  recipientName String
  phone       String
  region      String
  district    String
  street      String
  isDefault   Boolean @default(false)

  createdAt   DateTime @default(now())
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  image       String
  icon        String
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  products    Product[]

  @@index([isActive, sortOrder])
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  shortDescription String
  description   String
  ingredients   String?
  usage         String?
  benefits      String?
  precautions   String?
  price         Float
  compareAtPrice Float?
  sku           String   @unique
  stock         Int      @default(0)
  lowStockThreshold Int @default(5)
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE | DRAFT | OUT_OF_STOCK
  isBestSeller  Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  rating        Float    @default(0)
  ratingCount   Int      @default(0)
  images        String   @default("") // comma-separated paths
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  reviews       Review[]
  orderItems    OrderItem[]
  wishlist      WishlistItem[]
  productViews  ProductView[]

  @@index([categoryId, status])
  @@index([status, createdAt])
  @@index([status, isBestSeller, ratingCount])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  author    String
  rating    Int
  title     String?
  comment   String
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([productId, isApproved, createdAt])
}

model Order {
  id            String     @id @default(cuid())
  orderNumber   String     @unique
  userId        String?
  user          User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName  String
  customerEmail String
  customerPhone String
  region        String
  district      String
  address       String
  notes         String?
  couponCode    String?
  subtotal      Float
  discount      Float      @default(0)
  shipping      Float
  total         Float
  currency      String     @default("TZS")
  status        String     @default("PENDING") // PENDING | PAID | PROCESSING | DISPATCHED | DELIVERED | CANCELLED
  paymentMethod String
  paymentStatus String     @default("UNPAID") // UNPAID | PAID | FAILED | REFUNDED
  paymentReference String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  items         OrderItem[]
  payments      Payment[]
  paymentLogs   PaymentLog[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productSlug  String
  productImage String?
  price        Float
  quantity     Int
  subtotal     Float

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id            String   @id @default(cuid())
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  provider      String   // MANUAL | SELCOM | FLUTTERWAVE | DPO
  amount        Float
  status        String   @default("PENDING") // PENDING | SUCCESS | FAILED | REFUNDED
  reference     String
  transactionId String?
  raw           String?
  createdAt     DateTime @default(now())

  logs          PaymentLog[]

  @@index([orderId, createdAt])
}

// Payment status log: append-only history of every payment attempt/transition.
model PaymentLog {
  id            String   @id @default(cuid())
  paymentId     String?
  payment       Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String
  status        String   // CREATED | PENDING | SUCCESS | FAILED | REFUNDED
  amount        Float?
  reference     String?
  message       String?
  createdAt     DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([paymentId, createdAt])
}

// Activity log: audit trail of admin/system actions.
model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  role      String?
  action    String   // e.g. ORDER_UPDATE, PRODUCT_CREATE, LOGIN
  entity    String?
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Coupon {
  id         String   @id @default(cuid())
  code       String   @unique
  type       String   @default("PERCENTAGE") // PERCENTAGE | FIXED
  value      Float
  minOrder   Float    @default(0)
  maxDiscount Float?
  maxUses    Int?
  usedCount  Int      @default(0)
  startsAt   DateTime? // scheduled promotions: not active before this time
  expiresAt  DateTime?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([isActive, startsAt, expiresAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String   // page_view | view_item | add_to_cart | begin_checkout | purchase | search | whatsapp_click
  sessionId String?
  url       String?
  data      String?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  coverImage  String
  category    String
  author      String
  authorRole  String?
  publishedAt DateTime @default(now())
  isPublished Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  scheduledFor DateTime?
  seoTitle    String?
  seoDescription String?
  readingTime Int      @default(4)
  createdAt   DateTime @default(now())

  @@index([isPublished, publishedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @default("INFO") // ORDER | PROMO | ACCOUNT | INFO
  title     String
  message   String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model ProductView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model FinanceDocument {
  id          String   @id @default(cuid())
  docNumber   String   @unique
  type        String   // RECEIPT | INVOICE
  category    String   // EXTERNAL (customer-facing) | INTERNAL (business expenses e.g. water/electricity bills)
  title       String?
  partyName   String
  partyPhone  String?
  partyEmail  String?
  orderNumber String?  // linked web order, when generated from a customer order
  notes       String?
  subtotal    Float    @default(0)
  discount    Float    @default(0)
  tax         Float    @default(0)
  total       Float
  currency    String   @default("TZS")
  status      String   @default("ISSUED") // DRAFT | ISSUED | PAID | CANCELLED
  issueDate   DateTime
  dueDate     DateTime?
  paidAt      DateTime?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       FinanceDocumentItem[]

  @@index([category, createdAt])
}

model FinanceDocumentItem {
  id          String @id @default(cuid())
  documentId  String
  document    FinanceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  description String
  quantity    Int    @default(1)
  unitPrice   Float
  amount      Float

  @@index([documentId])
}

// Cash sales made at the branch counter. Approved sales count towards
// financial reports; until approved they appear as pending.
model CashSale {
  id           String   @id @default(cuid())
  saleNumber   String   @unique
  customerName String
  customerPhone String?
  items        String   @default("[]") // JSON array of {description, quantity, unitPrice, amount}
  subtotal     Float    @default(0)
  discount     Float    @default(0)
  total        Float
  status       String   @default("PENDING") // PENDING | APPROVED | CANCELLED
  notes        String?
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

// Walk-in customers who visit the physical branch.
model WalkInCustomer {
  id          String   @id @default(cuid())
  name        String
  phone       String?
  email       String?
  source      String   @default("WALK_IN") // WALK_IN | PHONE | REFERRAL | SOCIAL
  interest    String?
  notes       String?
  visitedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([visitedAt])
}
