generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  imageUrl String?
  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  description String?
  price       Float
  imageUrl    String?
  rating      String?   @default("4.8")
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SiteAsset {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  updatedAt DateTime @updatedAt
}
